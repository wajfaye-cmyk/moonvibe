// moonvibe Cosmetics-Server auf Cloudflare Workers.
// Online stellen: README → "Cosmetics-Server online stellen". Lokal testen: start-backend.bat
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  // eigener Port für den Testserver (8787 nutzen viele andere Cloudflare-Projekte)
  "dev": { "ip": "127.0.0.1", "port": 8777 },
  // Modelle, Texturen und Vorschaubilder nach public/ kopieren (werden direkt als Dateien ausgeliefert)
  "build": { "command": "node tools/build-assets.mjs", "watch_dir": ["cosmetics.json", "news.json"] },
  "assets": { "directory": "public" },
  // Wer trägt was + Anmelde-Sitzungen
  "d1_databases": [{ "binding": "DB", "database_name": "moonvibe", "database_id": "local", "migrations_dir": "migrations" }],
  // Eigene Capes der Spieler (Schlüssel = Prüfsumme)
  "kv_namespaces": [{ "binding": "CAPES", "id": "local" }],
  // Bremse gegen Spam (pro Adresse und Minute)
  "ratelimits": [
    { "name": "LIMIT", "namespace_id": "1001", "simple": { "limit": 90, "period": 60 } },
    { "name": "LIMIT_AUTH", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "LIMIT_CAPE", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
  ],
  // Einmal am Tag abgelaufene Sitzungen wegräumen
  "triggers": { "crons": ["17 4 * * *"] },
  "observability": { "enabled": true }
}
